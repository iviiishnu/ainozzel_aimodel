# Copy to .env and adjust. All values are optional; defaults shown.

# Server
ML_HOST=0.0.0.0
ML_PORT=5010
ML_THREADS=4
FLASK_DEBUG=false
MAX_UPLOAD_MB=10

# Model
# MODEL_PATH=models/crop_model_best.h5   # default: first of crop_model_best.h5, new_model.h5, crop_model_float16.tflite in MODEL_DIR
# MODEL_DIR=models
# CLASS_NAMES_PATH=models/class_names.json
TTA_VARIANTS=5

# Decision thresholds — keep in sync with the Flutter app (lib/config.dart) and ESP32 firmware
CONFIDENCE_THRESHOLD=0.50
SPRAY_CONFIDENCE=0.60
MAX_HEALTHY_PROB=0.10
DAMAGE_MEDIUM=15
DAMAGE_HIGH=35

# How a leaf is judged diseased: "confidence" (top class must be a disease with
# >= SPRAY_CONFIDENCE) or "score" (spray when 1 - P(Healthy) - P(Not_Leaf) >=
# SPRAY_SCORE, whichever disease it is). On real field photos "score" at 0.7
# misses ~15% of diseased leaves instead of ~29%, at ~15% instead of ~9% healthy
# leaves sprayed. Mirror it in the app: --dart-define=SPRAY_RULE=score
SPRAY_RULE=confidence
SPRAY_SCORE=0.70

# Leaf pre-check. Frames with less than LEAF_HARD_FRACTION plant colour are
# rejected outright; between that and 0.10 only a confident Diseased/Healthy
# result (>= LEAF_OVERRIDE_CONFIDENCE) counts as a leaf, so dark/necrotic
# leaves (e.g. Anthracnose) are not rejected as "no leaf".
LEAF_HARD_FRACTION=0.02
LEAF_OVERRIDE_CONFIDENCE=0.85
